<view class="login-container">
  <view class="login-header">
    <view class="title">欢迎回来</view>
    <view class="subtitle">登录 FitAgent</view>
  </view>

  <view class="login-form">
    <view class="input-item">
      <text class="label">手机号</text>
      <input
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="input-item">
      <text class="label">密码</text>
      <input
        type="password"
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>
  </view>

  <button
    class="btn-primary"
    disabled="{{!canSubmit || loading}}"
    bindtap="onLogin"
  >
    {{loading ? '登录中...' : '登 录'}}
  </button>

  <view class="link" bindtap="goToRegister">
    没有账号？去注册
  </view>
</view>