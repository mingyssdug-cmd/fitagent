/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* 通用容器 */
.container {
  padding: 40rpx;
  box-sizing: border-box;
}

/* 通用按钮 */
.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #1aad19;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 8rpx;
  text-align: center;
  margin-top: 40rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background-color: #cccccc;
  color: #ffffff;
}

/* 通用输入框 */
.input-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.input-item .label {
  width: 160rpx;
  font-size: 30rpx;
  color: #666;
}

.input-item input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

/* 通用文字链接 */
.link {
  color: #1aad19;
  font-size: 28rpx;
  text-align: center;
  margin-top: 30rpx;
  display: block;
}